{
	"name": "Repdraft",
	"short_name": "Repdraft",
	"description": "Тренировки, техника и запись подходов",
	"id": "/",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "portrait-primary",
	"background_color": "#0A0A0D",
	"theme_color": "#0A0A0D",
	"lang": "ru",
	"prefer_related_applications": false,
	"related_applications": [
		{
			"platform": "webapp",
			"url": "/manifest.webmanifest"
		}
	],
	"icons": [
		{
			"src": "/icon-192-v2.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-512-v2.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-maskable-512-v2.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Продолжить тренировку",
			"short_name": "Главная",
			"description": "Главная: продолжить или начать",
			"url": "/",
			"icons": [{ "src": "/icon-192-v2.png", "sizes": "192x192" }]
		},
		{
			"name": "Новая тренировка",
			"short_name": "Новая",
			"description": "Создать тренировку",
			"url": "/builder?new=1",
			"icons": [{ "src": "/icon-192-v2.png", "sizes": "192x192" }]
		}
	]
}
