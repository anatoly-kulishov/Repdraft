# Canonical public URL for SEO (sitemap, og:url, canonical).
# Single prod alias (Vercel Domains → Production):
PUBLIC_SITE_URL=https://repdraft-zeta.vercel.app

# Optional absolute origin for account APIs (delete/avatar). Defaults to PUBLIC_SITE_URL, then browser origin.
# PUBLIC_WEB_ORIGIN=https://repdraft-zeta.vercel.app

PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable (sb_publishable_…) or legacy anon JWT from Project Settings → API Keys
PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# --- Auth dashboard (required for v0.6+ sign-in methods) ---
# Supabase → Authentication → Providers:
#   - Email: ON (password + magic link + reset)
#   - Password min length: 10 (match app policy)
# Supabase → Authentication → URL Configuration:
#   Site URL: https://repdraft-zeta.vercel.app
#   Redirect URLs:
#     https://repdraft-zeta.vercel.app/auth
#     http://localhost:5173/auth
#     http://127.0.0.1:5173/auth
# Details: AGENTS.md «Supabase Auth» and .cursor/rules/supabase-auth.mdc

# Optional: Cloudflare Turnstile (site key). Secret stays in Supabase Bot Protection.
# PUBLIC_TURNSTILE_SITE_KEY=0x...

# Optional ops only (never expose to the browser / PUBLIC_*):
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Required on the server (Vercel env) for «Delete account» at POST /api/account/delete.

# REQUIRED before public release (shown on /privacy and /terms):
# Use real operator identity — do not ship placeholders.
PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@your-domain.com
PUBLIC_PRIVACY_OPERATOR_NAME=ИП Иванов Иван Иванович
# PUBLIC_PRIVACY_OPERATOR_INN=123456789012
# PUBLIC_PRIVACY_OPERATOR_ADDRESS=г. Москва, ул. Пример, д. 1

# Web analytics (Vercel Analytics / Speed Insights) is NOT an env flag.
# Opt-in in Profile → Interface (localStorage key repdraft:web-analytics). Default off.

# --- Draft with AI /ai (private server env; never PUBLIC_*) ---
# AI_PROVIDER=gigachat
# GIGACHAT_API_KEY=
# GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_BASE_URL=https://api.giga.chat/v1
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_SSL_VERIFY=false
# Or local:
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:3b
# Embeddings for /ai RAG (default Ollama; GigaChat embeddings often 402 on PERS):
# EMBEDDINGS_PROVIDER=ollama
# EMBEDDINGS_MODEL=nomic-embed-text
# Rebuild index: node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./scripts/build-embeddings.ts
