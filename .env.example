# --- Core ---
PUBLIC_SITE_URL=https://www.repdraft.ru
# Node host (docker compose): same value as ORIGIN for CSRF / absolute URLs
# ORIGIN=https://www.repdraft.ru
# Search Console / Yandex Webmaster meta tokens (optional; HTML/DNS methods also work)
# PUBLIC_GOOGLE_SITE_VERIFICATION=
# PUBLIC_YANDEX_VERIFICATION=
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- Legal (/privacy, /terms, /legal/requisites) ---
# Empty values render an explicit "не указан" placeholder until the host env is filled.
PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@your-domain.com
PUBLIC_PRIVACY_OPERATOR_NAME=Your legal name
# PUBLIC_PRIVACY_OPERATOR_INN=
# PUBLIC_PRIVACY_OPERATOR_OGRN=
# PUBLIC_PRIVACY_OPERATOR_ADDRESS=

# --- Server (never commit real values) ---
SUPABASE_SERVICE_ROLE_KEY=
# PUBLIC_TURNSTILE_SITE_KEY=

# --- Feedback form (/feedback -> SMTP -> your inbox) ---
# Yandex 360: SMTP needs an app password, not the mailbox password.
# smtp.yandex.ru:465 uses implicit TLS; port 587 uses STARTTLS (secure=false).
# Without the user/pass pair the form still renders but answers "temporarily unavailable".
FEEDBACK_SMTP_HOST=smtp.yandex.ru
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_SECURE=true
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_PASS=
# Where messages land; falls back to PUBLIC_PRIVACY_CONTACT_EMAIL.
FEEDBACK_EMAIL_TO=
# From header; defaults to FEEDBACK_SMTP_USER (Yandex allows owned aliases only).
FEEDBACK_EMAIL_FROM=
# Probe: npm run check:feedback (names only), npm run check:feedback -- --send

# --- AI (draft free + Pro photo recognize) ---
AI_PROVIDER=gigachat
GIGACHAT_API_KEY=
GIGACHAT_MODEL=GigaChat-2
AI_VISION_MODEL=GigaChat-2-Max
AI_PLAN_DAILY_LIMIT=10
# Pro photo recognition (vision model, ~10x a text call); Excel/CSV is free
AI_RECOGNIZE_DAILY_LIMIT=4
# GIGACHAT_BASE_URL=
# GIGACHAT_OAUTH_URL=
# GIGACHAT_SCOPE=
# GIGACHAT_SSL_VERIFY=
# EMBEDDINGS_PROVIDER=gigachat
# EMBEDDINGS_MODEL=Embeddings

# --- Billing Pro (web checkout; RN opens the site) ---
# SQL: ~/.repdraft-sql/billing-entitlements.sql
# Probe: npm run check:billing
# Webhook: https://www.repdraft.ru/api/billing/webhook/yookassa (payment.succeeded)
# Also set the same keys in the RF VPS `.env`.
BILLING_DEFAULT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_AMOUNT_MONTHLY=149.00
YOOKASSA_AMOUNT_YEARLY=1490.00
YOOKASSA_CURRENCY=RUB
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
