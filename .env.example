# --- Core ---
PUBLIC_SITE_URL=https://www.repdraft.xyz
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- Legal (/privacy, /terms) ---
PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@your-domain.com
PUBLIC_PRIVACY_OPERATOR_NAME=Your legal name
# PUBLIC_PRIVACY_OPERATOR_INN=
# PUBLIC_PRIVACY_OPERATOR_ADDRESS=

# --- Server (never commit real values) ---
SUPABASE_SERVICE_ROLE_KEY=
# PUBLIC_TURNSTILE_SITE_KEY=

# --- AI (draft free + Pro photo recognize) ---
AI_PROVIDER=gigachat
GIGACHAT_API_KEY=
GIGACHAT_MODEL=GigaChat-2
AI_VISION_MODEL=GigaChat-2-Max
AI_PLAN_DAILY_LIMIT=10
# GIGACHAT_BASE_URL=
# GIGACHAT_OAUTH_URL=
# GIGACHAT_SCOPE=
# GIGACHAT_SSL_VERIFY=
# EMBEDDINGS_PROVIDER=gigachat
# EMBEDDINGS_MODEL=Embeddings

# --- Billing Pro (web checkout; RN opens the site) ---
# SQL: ~/.repdraft-sql/billing-entitlements.sql
# Probe: npm run check:billing
# Webhook: https://www.repdraft.xyz/api/billing/webhook/yookassa (payment.succeeded)
# Also set the same keys in Vercel Production/Preview.
BILLING_DEFAULT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_AMOUNT_MONTHLY=149.00
YOOKASSA_AMOUNT_YEARLY=1490.00
YOOKASSA_CURRENCY=RUB
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
