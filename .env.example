# --- Core (web) ---
PUBLIC_SITE_URL=https://www.repdraft.xyz
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Legal (/privacy, /terms) - real values before public release
PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@your-domain.com
PUBLIC_PRIVACY_OPERATOR_NAME=Your legal name

# --- Server only (Vercel / local .env, never PUBLIC_*) ---
# Account delete, avatar upload, /ai exercise RAG (match_exercises + npm run build:embeddings)
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# PUBLIC_WEB_ORIGIN=https://www.repdraft.xyz
# PUBLIC_TURNSTILE_SITE_KEY=
# PUBLIC_PRIVACY_OPERATOR_INN=
# PUBLIC_PRIVACY_OPERATOR_ADDRESS=

# AI draft /ai (omit = AI UI degrades; sacred loop unchanged)
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:3b
# Or: AI_PROVIDER=gigachat + GIGACHAT_API_KEY (+ GIGACHAT_* as needed)

# Catalog RAG embeddings (defaults: ollama / nomic-embed-text). Setup: .cursor/product/exercise-rag.md
# EMBEDDINGS_PROVIDER=ollama
# EMBEDDINGS_MODEL=nomic-embed-text
