{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@repdraft/domain/*": [
        "../src/lib/domain/*"
      ],
      "@repdraft/i18n/*": [
        "../src/lib/i18n/*"
      ],
      "@repdraft/design/*": [
        "../src/lib/design/*"
      ],
      "$lib/domain/*": [
        "../src/lib/domain/*"
      ],
      "$lib/i18n/*": [
        "../src/lib/i18n/*"
      ],
      "$lib/design/*": [
        "../src/lib/design/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/lib/domain/**/*.ts",
    "../src/lib/i18n/**/*.ts",
    "../src/lib/design/**/*.ts"
  ]
}
