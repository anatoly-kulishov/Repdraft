# Optional cloud (same project as web PWA). Leave empty for local-only.
# `npm run mobile` copies PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY from the repo root .env
# when these are empty. Restart Metro after changing them.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public web origin for catalog images, AI API and exercise technique.
# Use https://www.repdraft.xyz for production.
# For local dev with a simulator/device, put your machine's LAN IP here, e.g.:
# EXPO_PUBLIC_WEB_ORIGIN=http://192.168.0.104:5173
# `localhost` / `127.0.0.1` will NOT work from the iOS simulator or a physical phone.
EXPO_PUBLIC_WEB_ORIGIN=https://www.repdraft.xyz
