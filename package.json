{
	"name": "repdraft",
	"private": true,
	"version": "0.22.0",
	"description": "Gym workout log - React Native (mobile/) + SvelteKit web/PWA, shared domain",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"dev:all": "node ./scripts/dev-all.mjs",
		"prebuild": "node ./scripts/copy-catalog-full.mjs",
		"build": "vite build",
		"preview": "vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"build:data": "node scripts/build-exercise-data.mjs",
		"translate:names": "python3 scripts/translate-exercise-names.py && npm run build:data",
		"translate:instructions": "python3 scripts/translate-exercise-instructions-ru.py",
		"apply:instructions": "python3 scripts/apply-exercise-instructions-ru.py",
		"mobile": "npm run start --prefix mobile",
		"mobile:ios": "npm run ios --prefix mobile",
		"mobile:android": "npm run android --prefix mobile",
		"check:mobile": "npm run typecheck --prefix mobile",
		"check:all": "npm run check && npm run check:mobile",
		"build:tokens": "node scripts/build-design-tokens.mjs",
		"check:tokens": "node scripts/check-design-tokens.mjs",
		"check:versions": "node scripts/check-versions.mjs",
		"check:parity": "npm run check:tokens && npm run check:versions && npm run check:all",
		"bump:version": "node scripts/bump-version.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"build:embeddings": "node --env-file=.env --experimental-strip-types ./scripts/build-embeddings.ts",
		"icons:pwa": "node ./scripts/generate-brand-icons.mjs",
		"backfill:gif-cache": "node --env-file=.env scripts/backfill-technique-gif-cache.mjs"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.2.0",
		"sharp": "^0.34.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.33.0",
		"@supabase/supabase-js": "^2.110.8",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"gifenc": "^1.0.3",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	}
}
