{
	"name": "repdraft",
	"private": true,
	"version": "0.5.0",
	"description": "Каталог упражнений и конструктор тренировок",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"build:data": "node scripts/build-exercise-data.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:insights": "node --experimental-strip-types ./src/lib/domain/insights.selfcheck.ts",
		"check:filters": "node --experimental-strip-types ./src/lib/domain/filters.selfcheck.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.2.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.110.8",
		"gifenc": "^1.0.3"
	}
}
