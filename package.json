{
	"name": "repdraft",
	"private": true,
	"version": "0.16.1",
	"description": "Каталог упражнений и конструктор тренировок",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"prebuild": "node ./scripts/copy-catalog-full.mjs",
		"build": "vite build",
		"lighthouse:mobile": "node ./scripts/lighthouse.mjs",
		"preview": "vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"build:data": "node scripts/build-exercise-data.mjs",
		"translate:names": "python3 scripts/translate-exercise-names.py && npm run build:data",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:domain": "node ./scripts/run-domain-selfchecks.mjs",
		"check:filters": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/filters.selfcheck.ts",
		"check:workout": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/workout.selfcheck.ts",
		"check:session": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/session.selfcheck.ts",
		"check:records": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/records.selfcheck.ts",
		"check:clips": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/clips.selfcheck.ts",
		"check:input": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/inputLimits.selfcheck.ts",
		"check:auth": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/authFlow.selfcheck.ts",
		"smoke:catalog-hub": "node ./scripts/smoke-catalog-hub.mjs",
		"smoke:mvp": "node ./scripts/smoke-catalog-hub.mjs",
		"icons:pwa": "node ./scripts/render-pwa-icons.mjs",
		"e2e:ui": "node ./scripts/e2e-ui-audit.mjs",
		"e2e:overflow": "node ./scripts/e2e-overflow-stress.mjs",
		"gen:stress-backup": "node ./scripts/gen-stress-backup.mjs",
		"test:e2e": "playwright test",
		"test:e2e:history": "playwright test tests/e2e/history-detail.spec.ts --project=mobile-dark",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report .tmp/playwright-report",
		"css:split": "node ./scripts/split-app-css.mjs",
		"backfill:gif-cache": "node --env-file=.env scripts/backfill-technique-gif-cache.mjs",
		"validate": "svelte-kit sync && tsc --noEmit"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.3",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.2.0",
		"playwright": "^1.62.1",
		"sharp": "^0.34.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.33.0",
		"@supabase/supabase-js": "^2.110.8",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"gifenc": "^1.0.3",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	}
}
