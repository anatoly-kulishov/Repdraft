{
	"name": "repdraft",
	"private": true,
	"version": "0.7.0",
	"description": "Каталог упражнений и конструктор тренировок",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"build:data": "node scripts/build-exercise-data.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:domain": "node ./scripts/run-domain-selfchecks.mjs",
		"check:insights": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/insights.selfcheck.ts",
		"check:filters": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/filters.selfcheck.ts",
		"check:workout": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/workout.selfcheck.ts",
		"check:session": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/session.selfcheck.ts",
		"check:records": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/records.selfcheck.ts",
		"check:clips": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/clips.selfcheck.ts",
		"check:input": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/inputLimits.selfcheck.ts",
		"check:auth": "node --import ./scripts/register-domain-selfcheck.mjs --experimental-strip-types ./src/lib/domain/authFlow.selfcheck.ts",
		"smoke:catalog-hub": "node ./scripts/smoke-catalog-hub.mjs",
		"smoke:mvp": "node ./scripts/smoke-catalog-hub.mjs",
		"e2e:ui": "node ./scripts/e2e-ui-audit.mjs",
		"backfill:gif-cache": "node --env-file=.env scripts/backfill-technique-gif-cache.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.2.0",
		"playwright": "^1.62.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@lucide/svelte": "^1.31.0",
		"@supabase/supabase-js": "^2.110.8",
		"gifenc": "^1.0.3"
	}
}
