{
	"headers": [
		{
			"source": "/data/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400, stale-while-revalidate=604800"
				}
			]
		},
		{
			"source": "/images/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/videos/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/icon-(192|512)-v3\\.png",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400"
				}
			]
		},
		{
			"source": "/icon-maskable-512-v3\\.png",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400"
				}
			]
		},
		{
			"source": "/apple-touch-icon(-precomposed)?-v3\\.png",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400"
				}
			]
		},
		{
			"source": "/favicon\\.ico",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400"
				},
				{
					"key": "Content-Type",
					"value": "image/x-icon"
				}
			]
		},
		{
			"source": "/favicon-(16x16|32x32|48x48)\\.png",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400"
				}
			]
		},
		{
			"source": "/sitemap\\.xml",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				},
				{
					"key": "Content-Type",
					"value": "application/xml; charset=utf-8"
				}
			]
		},
		{
			"source": "/robots\\.txt",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				}
			]
		}
	]
}
